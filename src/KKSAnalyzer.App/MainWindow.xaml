<Window x:Class="KKSAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KKS Analyzer" Height="800" Width="1180" MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,16">
            <Border DockPanel.Dock="Right" Background="#E8EEFF" CornerRadius="14" Padding="11,5" VerticalAlignment="Center">
                <TextBlock Text="Локальная обработка файлов" Foreground="#3159BE" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <StackPanel>
                <TextBlock Text="KKS Analyzer" FontSize="28" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="Проверяйте, сравнивайте и находите сигналы в технической документации" FontSize="14" Foreground="#69758C" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="ModeTabs" Background="White" Padding="8">
            <TabItem Header="Один файл">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Content="Открыть TXT / CFG" Click="OpenSingleFile_Click" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="SaveCleanButton" Content="Сохранить без дубликатов" Click="SaveCleanFile_Click" IsEnabled="False" />
                        <TextBlock x:Name="SingleFileName" Text="Файл не выбран" VerticalAlignment="Center" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="#EDF3FF" CornerRadius="8" Padding="13" Margin="0,0,0,12">
                        <TextBlock x:Name="SingleSummary" Text="Загрузите файл для анализа." Foreground="#1E3A8A" />
                    </Border>
                    <TabControl Grid.Row="2">
                        <TabItem Header="Все сигналы">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#F7F9FC" BorderBrush="#DFE5EF" BorderThickness="1,1,1,0" Padding="10,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Выбрать все" Click="SelectAllSignals_Click" Padding="11,6" />
                                            <Button Content="Снять выделение" Click="ClearSignalSelection_Click" Padding="11,6" />
                                            <Button x:Name="ExcludeSelectedButton" Content="Исключить выбранные…" Click="ExcludeSelectedSignals_Click"
                                                    Style="{StaticResource PrimaryButton}" Padding="11,6" Margin="0" IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SignalSelectionSummary" Text="Ничего не выбрано" FontWeight="SemiBold" />
                                            <TextBlock Text="Используйте Ctrl для отдельных строк или Shift для диапазона" FontSize="11" Foreground="#69758C" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataGrid Grid.Row="1" x:Name="AllSignalsGrid" MouseDoubleClick="CodeGrid_MouseDoubleClick"
                                          SelectionMode="Extended" SelectionChanged="AllSignalsGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="KKS-код" Binding="{Binding Code}" Width="*" />
                                        <DataGridTextColumn Header="Основная часть" Binding="{Binding MainPart}" Width="220" />
                                        <DataGridTextColumn Header="Постфикс" Binding="{Binding SuffixDisplay}" Width="110" />
                                        <DataGridTextColumn Header="Раздел" Binding="{Binding SectionDisplay}" Width="190" />
                                        <DataGridTextColumn Header="Строка" Binding="{Binding LineNumber}" Width="75" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Дубликаты">
                            <DataGrid x:Name="DuplicatesGrid" MouseDoubleClick="CodeGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="KKS-код" Binding="{Binding Code}" Width="*" />
                                    <DataGridTextColumn Header="Раздел" Binding="{Binding SectionDisplay}" Width="190" />
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="100" />
                                    <DataGridTextColumn Header="Строки" Binding="{Binding Lines}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Без постфикса">
                            <DataGrid x:Name="NoSuffixGrid" MouseDoubleClick="CodeGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="KKS-код" Binding="{Binding Code}" Width="*" />
                                    <DataGridTextColumn Header="Раздел" Binding="{Binding SectionDisplay}" Width="220" />
                                    <DataGridTextColumn Header="Строка" Binding="{Binding LineNumber}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Постфиксы #IA1000">
                            <DataGrid x:Name="AnalogSuffixGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Постфикс" Binding="{Binding Suffix}" Width="150" />
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="110" />
                                    <DataGridTextColumn Header="Примеры" Binding="{Binding Examples}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Постфиксы #ID1000">
                            <DataGrid x:Name="DiscreteSuffixGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Постфикс" Binding="{Binding Suffix}" Width="150" />
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="110" />
                                    <DataGridTextColumn Header="Примеры" Binding="{Binding Examples}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Общие постфиксы IA / ID">
                            <DataGrid x:Name="CommonSuffixGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Постфикс" Binding="{Binding Suffix}" Width="120" />
                                    <DataGridTextColumn Header="В IA" Binding="{Binding AnalogCount}" Width="80" />
                                    <DataGridTextColumn Header="В ID" Binding="{Binding DiscreteCount}" Width="80" />
                                    <DataGridTextColumn Header="Примеры IA" Binding="{Binding AnalogExamples}" Width="*" />
                                    <DataGridTextColumn Header="Примеры ID" Binding="{Binding DiscreteExamples}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Два файла">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,12">
                            <Button Content="Выбрать файл 1" Click="OpenFirstFile_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
                            <TextBlock x:Name="FirstFileName" Text="Файл не выбран" Foreground="#64748B" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,12">
                            <Button Content="Выбрать файл 2" Click="OpenSecondFile_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
                            <TextBlock x:Name="SecondFileName" Text="Файл не выбран" Foreground="#64748B" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#EDF3FF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <DockPanel>
                            <ComboBox x:Name="ComparisonFilter" Width="190" DockPanel.Dock="Right" SelectionChanged="ComparisonFilter_SelectionChanged">
                                <ComboBoxItem Content="Все сигналы" IsSelected="True" />
                                <ComboBoxItem Content="В обоих файлах" />
                                <ComboBoxItem Content="Только в файле 1" />
                                <ComboBoxItem Content="Только в файле 2" />
                            </ComboBox>
                            <TextBlock x:Name="ComparisonSummary" Text="Выберите два файла для сравнения." Foreground="#1E3A8A" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Действие с файлами" FontWeight="SemiBold" />
                                <TextBlock Text="Результат сохраняется в новый файл" FontSize="11" Foreground="#69758C" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ComparisonAction" SelectionChanged="ComparisonAction_SelectionChanged">
                                <ComboBoxItem Content="Файл 1 без общих кодов" Tag="first_minus_common" IsSelected="True" />
                                <ComboBoxItem Content="Файл 2 без общих кодов" Tag="second_minus_common" />
                                <ComboBoxItem Content="Дополнить файл 1 кодами файла 2" Tag="merge_into_first" />
                                <ComboBoxItem Content="Дополнить файл 2 кодами файла 1" Tag="merge_into_second" />
                                <ComboBoxItem Content="Объединение всех уникальных кодов" Tag="union" />
                                <ComboBoxItem Content="Только общие коды" Tag="intersection" />
                                <ComboBoxItem Content="Только различающиеся коды" Tag="symmetric_difference" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" x:Name="ComparisonActionHint" Margin="14,0" VerticalAlignment="Center" Foreground="#69758C"
                                       Text="Удалит из копии файла 1 все коды, которые встречаются в файле 2." TextWrapping="Wrap" />
                            <Button Grid.Column="3" x:Name="RunComparisonActionButton" Content="Сохранить результат" Click="RunComparisonAction_Click"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0" />
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="3" x:Name="ComparisonGrid" MouseDoubleClick="CodeGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KKS-код" Binding="{Binding Code}" Width="*" />
                            <DataGridTextColumn Header="Результат" Binding="{Binding Location}" Width="170" />
                            <DataGridTextColumn Header="Раздел в файле 1" Binding="{Binding FirstSection}" Width="190" />
                            <DataGridTextColumn Header="Раздел в файле 2" Binding="{Binding SecondSection}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Работа с кодами">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="KKS-коды для поиска" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBox x:Name="CodeSearchBox" Height="130" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Padding="8" TextWrapping="NoWrap" ToolTip="Один код в строке. Можно вставить сразу список." />
                            <TextBlock Text="По одному коду в строке; повторы будут удалены." Foreground="#64748B" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <DockPanel Margin="0,0,0,6">
                            <Button Content="Добавить документы" Click="AddSearchFiles_Click" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Очистить список" Click="ClearSearchFiles_Click" />
                                <TextBlock Text="Файлы для поиска" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="SearchFilesList" Height="130" DisplayMemberPath="DisplayName" />
                            <TextBlock Text="PDF, DOCX, TXT, CFG, CSV, LOG, MD, XML, JSON и RTF. Можно выбрать несколько файлов." Foreground="#64748B" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#EDF3FF" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                        <DockPanel>
                            <Button x:Name="StartSearchButton" Content="Найти коды" Click="StartCodeSearch_Click" DockPanel.Dock="Right"
                                    Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
                            <TextBlock x:Name="CodeSearchSummary" Text="Добавьте коды и документы, затем запустите поиск." Foreground="#1E3A8A" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Row="2" x:Name="CodeSearchResultsGrid" MouseDoubleClick="SearchResult_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KKS-код" Binding="{Binding Code}" Width="220" />
                            <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="190" />
                            <DataGridTextColumn Header="Найдено" Binding="{Binding Count}" Width="85" />
                            <DataGridTextColumn Header="Фрагмент" Binding="{Binding Snippet}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="4,10,4,0" Foreground="#64748B"
                   Text="Поиск и сравнение выполняются без учёта регистра. Исходные файлы не изменяются." />
    </Grid>
</Window>
